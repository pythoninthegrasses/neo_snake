#!/usr/bin/env python

# Thin GDExtension shim build (TASK-026): SConscript into third_party/godot-cpp's
# own SConstruct exactly the way godot-cpp's own test/SConstruct does, pinned to
# the game's Godot version (game/project.godot's config/features "4.7").
#
# SConscript()-included scripts run with Python's cwd changed to their own
# directory, so a bare "custom.py" there would resolve inside
# third_party/godot-cpp/, not here -- pass this dir's custom.py by absolute
# path via godot-cpp's own `customs` export hook (SConstruct: `customs +=
# Import("customs")`) instead.
customs = [File("custom.py").srcnode().abspath]
env = SConscript("../third_party/godot-cpp/SConstruct", {"api_version": "4.7", "customs": customs})

# godot-cpp's own generated-bindings object count blows past Linux's
# ARG_MAX for a bare `ar` invocation ("Argument list too long"); godot-cpp's
# own web.py platform hits the same wall and works around it the same way,
# via the same two-line ARCOM_POSIX + TEMPFILE(ARCOM_POSIX) pair (tools/web.py) --
# already applied to `env` by the time SConscript() returns it to us, so
# re-applying it here for platform=web wraps ARCOM_POSIX in a TEMPFILE(ARCOM_POSIX)
# that refers to itself, and SCons' subst blows the Python recursion limit trying
# to expand it (TASK-048). macOS's default ARG_MAX is large enough that the same
# object list never hits the wall, and its BSD `ar` doesn't accept GNU ar's
# response-file invocation this pair produces (TASK-043) -- so only apply it on
# linux/windows, where nothing has already handled it.
if env["platform"] not in ("macos", "web"):
    env["ARCOM_POSIX"] = env["ARCOM"].replace("$TARGET", "$TARGET.posix").replace("$SOURCES", "$SOURCES.posix")
    env["ARCOM"] = "${TEMPFILE(ARCOM_POSIX)}"

env.Append(CPPPATH=["src/", "../include"])
sources = Glob("src/*.cpp")

# Link core/zig-out/lib/libneo_snake.a (core/abi.zig, TASK-024) as an env.File(...)
# rather than -lneo_snake -Lpath: a bare linker flag doesn't tell SCons the .a is
# a real input, so a rebuilt core lib would silently not trigger a relink here.
#
# Zig names a windows-gnu target's static library "neo_snake.lib" instead of
# "libneo_snake.a" (still a plain ar archive of COFF objects underneath --
# just Windows' own conventional extension); extension:build-windows
# (TASK-046) always produces that name via `zig build abi
# -Dtarget=x86_64-windows-gnu`, so pick the matching filename here too.
core_lib_name = "neo_snake.lib" if env["platform"] == "windows" else "libneo_snake.a"
core_lib = env.File("../core/zig-out/lib/" + core_lib_name)
env.Append(LIBS=[core_lib])

# Zig's windows-gnu std lib references raw NtAllocateVirtualMemory/
# NtFreeVirtualMemory syscalls (panic/stack-guard machinery compiled into
# every build, even one that never panics) that live in ntdll.dll. A
# native `zig build-exe` resolves these itself when it does the final
# link, but core/zig-out/lib/neo_snake.lib is only a static archive --
# resolving them is deferred to whoever links it into something final,
# which here is mingw's own `ld` (TASK-046). mingw-w64 ships an import
# library for exactly this (libntdll.a); without it the final .dll link
# fails with "undefined reference to `NtAllocateVirtualMemory'" under
# godot-cpp's own -Wl,--no-undefined (tools/windows.py).
if env["platform"] == "windows":
    env.Append(LIBS=["ntdll"])

# Output name and directory match godot-cpp's own test/SConstruct convention
# (env["suffix"] already encodes platform/target/arch/.nothreads); game/bin/ is
# where game/bin/neo_snake.gdextension (TASK-027) points its per-platform
# [libraries] entries.
#
# macOS (TASK-043) is the one platform where the .gdextension's [libraries]
# entry (macos.debug/macos.release, see game/bin/neo_snake.gdextension) names
# a *.framework directory with no arch suffix, not a flat .dylib -- godot-cpp's
# own env["suffix"] always appends arch (tools/godotcpp.py), and neither
# godot-cpp nor Godot's own docs (gdextension_cpp_example.rst) do any
# framework-bundle packaging for the extension's own primary library, so this
# repo's SConstruct builds the bundle directly: a directory literally named
# "libneo_snake.macos.<target>.framework" containing one flat Mach-O binary of
# the same name (minus the .framework suffix) -- the same shape godot-cpp's
# own test/SConstruct uses, no Contents/Info.plist nesting required for a
# GDExtension's own primary library (that nesting is only for a *dependency*
# framework per gdextension_file.rst's Contents/Frameworks convention).
if env["platform"] == "macos":
    # Apple's newer default linker (ld-prime, Xcode 26+) enforces 8-byte
    # alignment on every Mach-O archive member; Zig's own archiver (which
    # produces core/zig-out/lib/libneo_snake.a via `zig build abi`) doesn't
    # satisfy that for at least one member, failing this final link step
    # with "not 8-byte aligned in ... libneo_snake.a" (TASK-043). The older
    # `ld_classic` linker (still shipped, `-Wl,-ld_classic`, deprecated but
    # functional) doesn't enforce this and links the same archive cleanly --
    # confirmed directly against the real archive on Xcode 26.6/mini before
    # applying this flag.
    env.Append(LINKFLAGS=["-Wl,-ld_classic"])
    bundle_name = "libneo_snake.macos.{}.framework".format(env["target"])
    library = env.SharedLibrary(
        "../game/bin/{}/{}".format(bundle_name, bundle_name.removesuffix(".framework")),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "../game/bin/libneo_snake{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )
env.Depends(library, core_lib)

Default(library)
