[configuration]

entry_symbol = "neo_snake_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://bin/libneo_snake.linux.template_debug.x86_64.so"
macos.debug = "res://bin/libneo_snake.macos.template_debug.framework"
macos.release = "res://bin/libneo_snake.macos.template_release.framework"
