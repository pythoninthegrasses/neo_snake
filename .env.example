# Taskfile Env Precedence
# Makes this repo's taskfile.yml env: block (mise-shimmed PATH, etc.) win
# over pre-existing OS environment variables, instead of the other way
# around. Required -- task check's guard step fails loudly without it.
# https://taskfile.dev/docs/experiments/env-precedence
TASK_X_ENV_PRECEDENCE=1

# Optional. Toolchain pins live in tools/game_toolchain.lock (the single
# source of truth, parsed by tools/toolchain.py). Any entry from that file
# can be overridden here by name, e.g.:
# GODOT_RELEASE=4.7.1-stable

# Optional. Overrides taskfile.yml's default vars.
# BREW_PREFIX=/opt/homebrew
# ZIG_GLOBAL_CACHE_DIR=/custom/path
